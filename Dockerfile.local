#   -v $PWD/tests/conf:/conf \
#   -e "ES_URL=http://<user>:<passwd>@<elastic_url>:<port>" \
#   -e "AMQP_URL=http://<user>:<passwd>@<rabbitmq_url>:<port>" \
#   maas-collector
